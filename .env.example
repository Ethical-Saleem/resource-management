# Copy to .env and fill in before running `docker compose up`.

# Browser-facing API base. Behind the same-origin IIS reverse proxy set up
# for the on-prem deployment, this should be a relative path so it resolves
# against whatever host the page was loaded from:
API_BASE_URL=/api

# This frontend's own public URL (used for the sitemap and OG tags).
APP_BASE_URL=https://your-domain-or-server-ip

# Server-side-only — lets SSR reach the api container directly over the
# Docker network instead of round-tripping back out through IIS. Leave
# blank for local dev; set to the Docker service URL in docker-compose.
API_BASE_INTERNAL_URL=http://api:3003/api
